# Локальные настройки backend (appsettings.json содержит реальный пароль
# Postgres, appsettings.Development.json — реальный Jwt:Secret) — не
# коммитятся. Non-secret ключи (Jwt:ExpiryMinutes/Issuer/Audience и т.д.),
# нужные Production, продублированы переменными окружения на Railway
# (Jwt__ExpiryMinutes/Jwt__Issuer/Jwt__Audience) — см. 2026-07-30, иначе
# TokenService.AccessTokenExpiryMinutes падает на каждом логине.
backend/MarketTJ.WebApi/appsettings.json
backend/MarketTJ.WebApi/appsettings.*.json

# .NET build artifacts — не коммитятся (были причиной постоянных merge-конфликтов
# между ветками: скомпилированные .dll/.pdb расходятся при каждой сборке).
backend/*/bin/
backend/*/obj/

# Загруженные пользователями файлы (аватарки, фото объявлений, фото в чате) —
# реальные данные, а не исходный код; папка создаётся сама при первой загрузке
# через IFileStorageService/LocalFileStorageService.
backend/MarketTJ.WebApi/wwwroot/uploads/

# Секреты docker-compose (POSTGRES_PASSWORD, ANTHROPIC_API_KEY, JWT_SECRET и т.д.) —
# см. .env.example для списка переменных.
.env
